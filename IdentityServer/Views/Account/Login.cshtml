@{
    Layout = null;
}
@model BookStore.IdentityServer.ViewModel.LoginViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="~/css/styles.css">
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <h2>Login</h2>
            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div class="input-group">
                    <label>Email</label>
                    <input asp-for="Email" type="email" placeholder="Enter your email" required />
                </div>
                <div class="input-group">
                    <label>Password</label>
                    <input asp-for="Password" type="password" placeholder="Enter your password" required />
                </div>
                <button type="submit" class="login-button">Login</button>
            </form>
            <p class="register-link">Don't have an account? <a asp-controller="Account" asp-action="Register">Register here</a></p>
        </div>
    </div>
</body>
</html>

