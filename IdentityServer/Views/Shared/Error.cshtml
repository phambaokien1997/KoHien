@model ErrorDetailViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error - IdentityServer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            color: #333;
            font-family: 'Arial', sans-serif;
        }
        .error-container {
            max-width: 700px;
            margin: 100px auto;
            padding: 20px;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .error-header {
            font-size: 24px;
            font-weight: bold;
            color: #dc3545;
        }
        .error-detail {
            margin-top: 20px;
        }
        .btn-home {
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="error-container">
            <div class="error-header">Oops! Something went wrong</div>
            <hr />
            <div class="error-detail">
                <p><strong>Error:</strong> @Model.Error</p>
                <p><strong>Description:</strong> @Model.Description</p>
               
                <p><strong>Request ID:</strong> @Model.RequestId</p>
            </div>
            <a href="/" class="btn btn-primary btn-home">Return to Home</a>
        </div>
    </div>
</body>
</html>

